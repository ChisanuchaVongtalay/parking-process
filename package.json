{
  "name": "mfu-parking-processor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup:vercel": "node src/db/setup-vercel-auth.mjs",
    "db:migrate:prod": "node src/db/migrate.js",
    "admin:bootstrap": "node src/db/bootstrap-admin.mjs",
    "db:seed": "tsx src/db/seed.ts",
    "processor:start": "node src/server.js",
    "worker:snapshot": "tsx workers/snapshot/index.ts",
    "test:snapshot": "tsx --test workers/snapshot/*.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "lru-cache": "^10.1.0",
    "lucide-react": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.7",
    "next": "^15.5.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-rnd": "^10.5.3",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
