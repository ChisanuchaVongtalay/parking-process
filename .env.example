# Use the same persistent directory for the web app, worker and migration.
# DATA_DIR=/absolute/path/to/data
SNAPSHOT_INTERVAL_SECONDS=60
SNAPSHOT_TIMEOUT_SECONDS=20
SNAPSHOT_CONCURRENCY=4
SNAPSHOT_RTSP_TRANSPORT=tcp
# Set on the web app; observations older than this are excluded from live summaries.
SNAPSHOT_MAX_AGE_SECONDS=900

# Public HTTPS origin of the Admin Console (production).
# PARKING_ADMIN_ORIGIN=https://parking.example.invalid
# Initial account for Docker startup or explicit Turso bootstrap/recovery.
# PARKING_SUPER_ADMIN_EMAIL=owner@lamduan.mfu.ac.th
# PARKING_SUPER_ADMIN_PASSWORD=

# Turso storage for Vercel authentication testing
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# One-time Super Admin password recovery (explicit Turso --recover only).
# PARKING_SUPER_ADMIN_RESET_ID=

# Optional: shared server-to-server User Web / Booking Service key, at least 32 characters.
# PARKING_USER_API_KEY=
